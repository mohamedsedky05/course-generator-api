ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_GENERATION_MODEL=claude-sonnet-4-6
CLAUDE_CLEANUP_MODEL=claude-haiku-4-5-20251001
CLAUDE_TRANSCRIPTION_MODEL=claude-sonnet-4-6
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Base64-encoded Netscape cookies.txt for server-side YouTube fallback (optional)
YOUTUBE_COOKIES_B64=
# Base64-encoded Netscape cookies.txt for Vimeo videos requiring login (optional)
VIMEO_COOKIES_B64=
BASIC_AUTH_USERNAME=your_api_username
BASIC_AUTH_PASSWORD=your_strong_api_password
MAX_TEXT_LENGTH=50000
TEMP_AUDIO_DIR=./temp_audio
# Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=*
